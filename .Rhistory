library(Biobase)
library(SingleCellExperiment)
library(MuSiC)
library(readxl)
library(ggplot2)
library(reshape2)
config <- list(
seurat_path   = "data/seurat_processed.rds",
bulk_path     = "data/oligo_counts_protein.coding.xlsx",
cell_type_col = "cell_label",   # columna creada en 00_Preprocessing
sample_col    = "Fragment",     # columna de pseudo-réplicas
output_dir    = "scripts/01_MuSiC/results",
figures_dir   = "scripts/01_MuSiC/figures"
)
cat("Cargando Seurat procesado...\n")
seurat_filt <- readRDS(config$seurat_path)
cat("Tipos celulares en referencia:\n")
print(table(seurat_filt@meta.data[[config$cell_type_col]]))
# Convertir Seurat → SingleCellExperiment
sce <- as.SingleCellExperiment(seurat_filt, assay = "RNA")
# Verificar columnas clave
stopifnot(config$cell_type_col %in% colnames(colData(sce)))
stopifnot(config$sample_col    %in% colnames(colData(sce)))
cat("\nCélulas por fragmento:\n")
print(table(colData(sce)[[config$sample_col]]))
cat("\nCargando bulk RNA-seq...\n")
bulk_raw <- read_excel(config$bulk_path)
gene_col <- colnames(bulk_raw)[1]
bulk_mat <- as.matrix(bulk_raw[, -1])
rownames(bulk_mat) <- bulk_raw[[gene_col]]
storage.mode(bulk_mat) <- "numeric"
bulk_eset <- ExpressionSet(assayData = bulk_mat)
cat("Dimensiones bulk:", nrow(bulk_eset), "genes x", ncol(bulk_eset), "muestras\n")
genes_common <- intersect(rownames(sce), rownames(bulk_eset))
cat("Genes comunes SCE-Bulk:", length(genes_common), "\n")
if (length(genes_common) < 1000) {
warning("Menos de 1000 genes comunes — revisa nomenclatura (ENSEMBL vs SYMBOL)")
}
sce_filt  <- sce[genes_common, ]
bulk_filt <- bulk_eset[genes_common, ]
cat("\nEjecutando MuSiC...\n")
cat("Hora de inicio:", format(Sys.time(), "%H:%M:%S"), "\n")
result <- music_prop(
bulk.mtx = exprs(bulk_filt),
sc.sce   = sce_filt,
clusters = config$cell_type_col,
samples  = config$sample_col,
verbose  = TRUE
)
cat("Hora de fin:", format(Sys.time(), "%H:%M:%S"), "\n")
prop_est       <- result$Est.prop.weighted
prop_df        <- as.data.frame(prop_est)
prop_df$sample <- rownames(prop_df)
prop_df        <- prop_df[, c("sample", setdiff(colnames(prop_df), "sample"))]
cat("\nProporciones estimadas:\n")
print(round(head(prop_est), 3))
dir.create(config$output_dir, showWarnings = FALSE, recursive = TRUE)
dir.create(config$figures_dir, showWarnings = FALSE, recursive = TRUE)
write.csv(prop_df,
file.path(config$output_dir, "proporciones_estimadas_music.csv"),
row.names = FALSE)
prop_long <- melt(prop_df,
id.vars       = "sample",
variable.name = "cell_type",
value.name    = "proportion")
p1 <- ggplot(prop_long, aes(x = sample, y = proportion, fill = cell_type)) +
geom_bar(stat = "identity", width = 0.7) +
scale_y_continuous(expand = c(0, 0), limits = c(0, 1.05)) +
labs(
title = "Composición celular estimada (MuSiC) — Oligodendroglioma",
x     = "Muestra bulk",
y     = "Proporción",
fill  = "Tipo celular"
) +
theme_classic() +
theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 6))
print(p1)
ggsave(file.path(config$figures_dir, "proporciones_estimadas_music.png"),
p1, width = 14, height = 6, dpi = 300)
cat("\n✓ Script MuSiC completado\n")
