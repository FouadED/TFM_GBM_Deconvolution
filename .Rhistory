# Parámetros configurables por el usuario
config <- list(
cell_type_col    = "Assignment",      # columna de tipos mayores
cell_subtype_col = "SubAssignment",   # columna de subtipos (NULL si no existe)
exclude_types    = c("BCells"),       # tipos a excluir
min_cells        = 20                 # mínimo de células por tipo
)
# Crear cell_label automáticamente
if (!is.null(config$cell_subtype_col) &&
config$cell_subtype_col %in% colnames(seurat_obj@meta.data)) {
seurat_obj@meta.data$cell_label <- ifelse(
is.na(seurat_obj@meta.data[[config$cell_subtype_col]]),
as.character(seurat_obj@meta.data[[config$cell_type_col]]),
as.character(seurat_obj@meta.data[[config$cell_subtype_col]])
)
cat("Usando subtipos de:", config$cell_subtype_col, "\n")
} else {
seurat_obj@meta.data$cell_label <-
as.character(seurat_obj@meta.data[[config$cell_type_col]])
cat("Usando tipos mayores de:", config$cell_type_col, "\n")
}
# Filtrar tipos excluidos
seurat_obj <- subset(seurat_obj,
cell_label %in% setdiff(
unique(seurat_obj@meta.data$cell_label),
config$exclude_types
)
)
# Filtrar tipos con pocas células
tabla <- table(seurat_obj@meta.data$cell_label)
tipos_validos <- names(tabla[tabla >= config$min_cells])
seurat_obj <- subset(seurat_obj,
cell_label %in% tipos_validos
)
